# Copy to .env.local and fill in real values for local development.
# Never commit a real .env.local file.
#
# All of these are NEXT_PUBLIC_* -- inlined into the client bundle at
# BUILD time (see frontend/Dockerfile), not read at container start.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable (not secret) key, from
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Error monitoring (see src/instrumentation-client.ts). Leave unset to
# disable Sentry entirely -- safe default for local dev/CI. No Session
# Replay/screen-recording is enabled even when this is set -- see that
# file's comment for why.
# NEXT_PUBLIC_SENTRY_DSN=
