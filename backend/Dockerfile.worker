# eric-submitter worker image -- deliberately SEPARATE from the main
# Dockerfile, which must never bake in the real ERiC SDK (see that
# file's header comment and app/eric/native_bindings.py's module
# docstring: ericapi.so must never load inside the web process).
#
# The real Linux ERiC SDK is NOT baked in at build time here either.
# First attempt was `COPY eric-sdk-linux /eric-sdk` from a local,
# gitignored directory (the extracted ERiC-44.2.4.0-Linux-x86_64.jar
# contents) -- this builds fine with a local `docker build` (reads the
# real filesystem), but fails on Railway: `railway up` only uploads
# git-tracked content, so the gitignored directory silently never
# reaches the build daemon, and the COPY fails with "not found". See
# app/eric_submitter/fetch_sdk.py's docstring for the real error and the
# fix: the SDK is uploaded once to S3 by hand and fetched at container
# STARTUP instead (this image's CMD), not baked in at build time.

FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=builder /install /usr/local
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

ENV ERIC_SDK_PATH=/eric-sdk

RUN useradd --create-home --uid 1000 taxengine && \
    mkdir -p /eric-sdk && chown taxengine:taxengine /eric-sdk
USER taxengine

CMD ["sh", "-c", "python -m app.eric_submitter.fetch_sdk && exec python -m app.eric_submitter.worker"]
