# eric-submitter worker image -- deliberately SEPARATE from the main
# Dockerfile, which must never bake in the real ERiC SDK (see that
# file's header comment and app/eric/native_bindings.py's module
# docstring: ericapi.so must never load inside the web process).
#
# Unlike local development (docker-compose.yml's eric-submitter service
# bind-mounts ERIC_SDK_HOST_PATH from the host), Railway has no access to
# the host filesystem a container builds on, so there's no bind-mount
# equivalent in production. This image bakes the real Linux ERiC SDK
# (backend/eric-sdk-linux/, a local directory junction to the extracted
# ERiC-44.2.4.0-Linux-x86_64.jar contents -- gitignored, never committed,
# see .dockerignore) directly into the image instead. The full SDK is
# copied as-is (~1.4GB, mostly lib/plugins/ -- 221 Datenart plugins)
# rather than trimmed to only the ESt-related plugins this project uses:
# guessing wrong about which plugins EricInitialisiere needs at runtime
# risks a real submission failing in a way that's hard to diagnose,
# which matters more here than image size.

FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.12-slim AS runtime

WORKDIR /app

COPY --from=builder /install /usr/local
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

# The real ERiC SDK, baked in -- see header comment above.
COPY eric-sdk-linux /eric-sdk
ENV ERIC_SDK_PATH=/eric-sdk

RUN useradd --create-home --uid 1000 taxengine
USER taxengine

CMD ["python", "-m", "app.eric_submitter.worker"]
