# Copy to .env.worker.local and fill in real values -- see
# docs/ELSTER_ERIC_INTEGRATION.md's Twelfth update for why the
# eric-submitter worker needs its OWN env file, pointed at its OWN
# database, deliberately separate from backend/.env (which the dev
# FastAPI app and test suite use). Never commit the real
# .env.worker.local (already covered by .gitignore's `.env.*.local`).
#
# The worker must NEVER share a database with anything used for manual
# UI testing -- it polls whatever DATABASE_URL points to and submits
# anything PENDING there for real, to the actual Finanzamt.
#
# Usage (from backend/):
#   set -a; source .env.worker.local; set +a  # bash
#   python -m app.eric_submitter.worker

DATABASE_URL=postgresql+psycopg://taxengine:taxengine@localhost:55432/taxengine_live

# Forward slashes deliberately, not backslashes on Windows -- `source`-ing
# this file from bash strips unquoted backslashes, silently corrupting a
# Windows-style path. Python/cffi's dlopen() accepts forward slashes on
# Windows just fine.
ERIC_SDK_PATH=/path/to/extracted/eric-sdk/ERiC-<version>/<Platform>

ERIC_HERSTELLER_ID=00000_override_in_env_once_registered
ENVIRONMENT=production
