# Copy to .env and fill in real values for local development.
# Never commit a real .env file.

DATABASE_URL=postgresql+psycopg://taxengine:taxengine@localhost:5432/taxengine
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Stripe test-mode keys, from https://dashboard.stripe.com/test/apikeys
# and the webhook endpoint's signing secret (dashboard, or `stripe listen`
# for local development).
#
# A LIVE secret key (sk_live_...) here requires ENVIRONMENT=production
# below -- Settings refuses to start otherwise (see app/config.py's
# _guard_against_live_stripe_key_outside_production), so routine local
# testing can never accidentally charge a real card.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

ENVIRONMENT=development

# Error monitoring (see app/monitoring.py). Leave unset to disable
# Sentry entirely -- safe default for local dev/CI. Request bodies are
# never sent to Sentry regardless of this setting, since this app's
# request bodies routinely contain a taxpayer's full tax/financial data.
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Only needed if instantiating NativeEricClient directly (e.g. the
# eric-submitter worker, or local integration testing against the real
# ERiC library) -- unused by the FastAPI app itself. Point at one
# platform's extracted ERiC-<version>-<Platform>.jar contents, e.g.
# C:\path\to\eric-sdk\ERiC-44.2.4.0\Windows-x86_64
# ERIC_SDK_PATH=

# BZSt-issued HerstellerID for this exact product name (see
# docs/ELSTER_ERIC_INTEGRATION.md) -- required by every real
# EricCheckXML()/EricBearbeiteVorgang() call once the worker actually
# runs. A different product needs its own separate HerstellerID.
# ERIC_HERSTELLER_ID=
