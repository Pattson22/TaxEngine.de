# Copy to .env and fill in real values for local development.
# Never commit a real .env file.

DATABASE_URL=postgresql+psycopg://taxengine:taxengine@localhost:5432/taxengine
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Stripe test-mode keys, from https://dashboard.stripe.com/test/apikeys
# and the webhook endpoint's signing secret (dashboard, or `stripe listen`
# for local development).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

ENVIRONMENT=development
